<?xml version="1.0" encoding="ISO-8859-1"?>
<devsComputationalModel:AtomicModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:devsComputationalModel="http://www.example.org/devsComputationalModel" name="HUMMINGBIRD_FEEDER" description="">
  <setsAndStructures xsi:type="devsComputationalModel:BooleanAlgebraSet"/>
  <setsAndStructures xsi:type="devsComputationalModel:NewSet" name="X_V_ARRIBAL" type="STRING">
    <elements xsi:type="devsComputationalModel:StringElement" value="small"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="tiny"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="medium"/>
  </setsAndStructures>
  <setsAndStructures xsi:type="devsComputationalModel:RealNumbersSet" includingZero="true"/>
  <setsAndStructures xsi:type="devsComputationalModel:NewSet" name="bird_type_domain" type="STRING">
    <elements xsi:type="devsComputationalModel:StringElement" value="small"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="nil"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="tiny"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="medium"/>
  </setsAndStructures>
  <setsAndStructures xsi:type="devsComputationalModel:NewSet" name="phase_domain" type="STRING">
    <elements xsi:type="devsComputationalModel:StringElement" value="passive"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="feeding"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="refilling"/>
    <elements xsi:type="devsComputationalModel:StringElement" value="querying"/>
  </setsAndStructures>
  <functions xsi:type="devsComputationalModel:ExternalTransitionFunction" name="deltaExt">
    <specifications xsi:type="devsComputationalModel:NextStateSpecification">
      <condition xsi:type="devsComputationalModel:If">
        <expression xsi:type="devsComputationalModel:LogicalOperation">
          <firstOperand xsi:type="devsComputationalModel:LogicalOperation">
            <firstOperand xsi:type="devsComputationalModel:LogicalOperation">
              <firstOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
                <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="phase"/>
                <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="passive"/>
              </firstOperand>
              <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
                <firstOperand xsi:type="devsComputationalModel:InputPortName" name="p"/>
                <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="arrival"/>
              </secondOperand>
            </firstOperand>
            <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
              <firstOperand xsi:type="devsComputationalModel:InputPortVariable" name="v"/>
              <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="tiny"/>
            </secondOperand>
          </firstOperand>
          <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="GREATER_THAN_OR_EQUAL_TO">
            <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="nectar_level"/>
            <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="2.1"/>
          </secondOperand>
        </expression>
      </condition>
      <stateVariable xsi:type="devsComputationalModel:ValueFromSet" variable="//@structure/@state/@variable.0" value="feeding"/>
      <stateVariable xsi:type="devsComputationalModel:ParameterName" variable="//@structure/@state/@variable.1" name="time_feed"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.2" name="nectar_level"/>
      <stateVariable xsi:type="devsComputationalModel:InputPortVariable" variable="//@structure/@state/@variable.3" name="v"/>
    </specifications>
    <specifications xsi:type="devsComputationalModel:NextStateSpecification">
      <condition xsi:type="devsComputationalModel:If">
        <expression xsi:type="devsComputationalModel:LogicalOperation">
          <firstOperand xsi:type="devsComputationalModel:LogicalOperation">
            <firstOperand xsi:type="devsComputationalModel:LogicalOperation">
              <firstOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
                <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="phase"/>
                <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="passive"/>
              </firstOperand>
              <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
                <firstOperand xsi:type="devsComputationalModel:InputPortName" name="p"/>
                <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="arrival"/>
              </secondOperand>
            </firstOperand>
            <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
              <firstOperand xsi:type="devsComputationalModel:InputPortVariable" name="v"/>
              <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="small"/>
            </secondOperand>
          </firstOperand>
          <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="GREATER_THAN_OR_EQUAL_TO">
            <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="nectar_level"/>
            <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="2.2"/>
          </secondOperand>
        </expression>
      </condition>
      <stateVariable xsi:type="devsComputationalModel:ValueFromSet" variable="//@structure/@state/@variable.0" value="feeding"/>
      <stateVariable xsi:type="devsComputationalModel:ParameterName" variable="//@structure/@state/@variable.1" name="time_feed"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.2" name="nectar_level"/>
      <stateVariable xsi:type="devsComputationalModel:InputPortVariable" variable="//@structure/@state/@variable.3" name="v"/>
    </specifications>
    <specifications xsi:type="devsComputationalModel:NextStateSpecification">
      <condition xsi:type="devsComputationalModel:If">
        <expression xsi:type="devsComputationalModel:LogicalOperation">
          <firstOperand xsi:type="devsComputationalModel:LogicalOperation">
            <firstOperand xsi:type="devsComputationalModel:LogicalOperation">
              <firstOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
                <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="phase"/>
                <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="passive"/>
              </firstOperand>
              <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
                <firstOperand xsi:type="devsComputationalModel:InputPortName" name="p"/>
                <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="arrival"/>
              </secondOperand>
            </firstOperand>
            <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
              <firstOperand xsi:type="devsComputationalModel:InputPortVariable" name="v"/>
              <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="medium"/>
            </secondOperand>
          </firstOperand>
          <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="GREATER_THAN_OR_EQUAL_TO">
            <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="nectar_level"/>
            <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="2.3"/>
          </secondOperand>
        </expression>
      </condition>
      <stateVariable xsi:type="devsComputationalModel:ValueFromSet" variable="//@structure/@state/@variable.0" value="feeding"/>
      <stateVariable xsi:type="devsComputationalModel:ParameterName" variable="//@structure/@state/@variable.1" name="time_feed"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.2" name="nectar_level"/>
      <stateVariable xsi:type="devsComputationalModel:InputPortVariable" variable="//@structure/@state/@variable.3" name="v"/>
    </specifications>
    <specifications xsi:type="devsComputationalModel:NextStateSpecification">
      <condition xsi:type="devsComputationalModel:If">
        <expression xsi:type="devsComputationalModel:LogicalOperation">
          <firstOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
            <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="phase"/>
            <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="passive"/>
          </firstOperand>
          <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
            <firstOperand xsi:type="devsComputationalModel:InputPortName" name="p"/>
            <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="refill"/>
          </secondOperand>
        </expression>
      </condition>
      <stateVariable xsi:type="devsComputationalModel:ValueFromSet" variable="//@structure/@state/@variable.0" value="refilling"/>
      <stateVariable xsi:type="devsComputationalModel:ParameterName" variable="//@structure/@state/@variable.1" name="time_refill"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.2" name="nectar_level"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.3" name="bird_type"/>
    </specifications>
    <specifications xsi:type="devsComputationalModel:NextStateSpecification">
      <condition xsi:type="devsComputationalModel:If">
        <expression xsi:type="devsComputationalModel:LogicalOperation">
          <firstOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
            <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="phase"/>
            <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="passive"/>
          </firstOperand>
          <secondOperand xsi:type="devsComputationalModel:ComparisonOperation" comparisonOperation="EQUAL_TO">
            <firstOperand xsi:type="devsComputationalModel:InputPortName" name="p"/>
            <secondOperand xsi:type="devsComputationalModel:ValueFromSet" value="amount"/>
          </secondOperand>
        </expression>
      </condition>
      <stateVariable xsi:type="devsComputationalModel:ValueFromSet" variable="//@structure/@state/@variable.0" value="querying"/>
      <stateVariable xsi:type="devsComputationalModel:ParameterName" variable="//@structure/@state/@variable.1" name="time_query"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.2" name="nectar_level"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.3" name="bird_type"/>
    </specifications>
    <specifications xsi:type="devsComputationalModel:NextStateSpecification">
      <condition xsi:type="devsComputationalModel:Otherwise"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.0" name="phase"/>
      <stateVariable xsi:type="devsComputationalModel:ArithmeticOperation" variable="//@structure/@state/@variable.1" arithmeticOperation="SUBSTRACTION">
        <firstOperand xsi:type="devsComputationalModel:PreviousStateVariable" name="sigma"/>
        <secondOperand xsi:type="devsComputationalModel:ElapsedTimeVariable"/>
      </stateVariable>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.2" name="nectar_level"/>
      <stateVariable xsi:type="devsComputationalModel:PreviousStateVariable" variable="//@structure/@state/@variable.3" name="bird_type"/>
    </specifications>
  </functions>
  <functions xsi:type="devsComputationalModel:InternalTransitionFunction" name="deltaInt">
