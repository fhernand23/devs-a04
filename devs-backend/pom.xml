<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================== -->
    <!-- Spring Boot                                           -->
    <!-- ====================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>


    <!-- ====================================================== -->
    <!-- Proyecto                                              -->
    <!-- ====================================================== -->

    <groupId>mapper.devs</groupId>
    <artifactId>Mapper_DEVS</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>Mapper_DEVS</name>
    <description>DEVS Text-to-Model mapper</description>


    <!-- ====================================================== -->
    <!-- Versiones                                             -->
    <!-- ====================================================== -->

    <properties>

        <java.version>21</java.version>

        <atl.version>4.12.0</atl.version>

        <ocl.version>1.21.0</ocl.version>

    </properties>


    <!-- ====================================================== -->
    <!-- Dependencias                                          -->
    <!-- ====================================================== -->

    <dependencies>


        <!-- ================================================== -->
        <!-- Spring Boot                                       -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- ================================================== -->
        <!-- ANTLR                                             -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.9.2</version>
        </dependency>


        <!-- ================================================== -->
        <!-- EMF                                               -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.common</artifactId>
            <version>2.23.0</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore</artifactId>
            <version>2.36.0</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
            <version>2.37.0</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.edit</artifactId>
            <version>2.24.0</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.codegen.ecore</artifactId>
            <version>2.30.0</version>
        </dependency>


        <!-- ================================================== -->
        <!-- Eclipse Runtime                                   -->
        <!-- Necesario por NullProgressMonitor usado por ATL   -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.core.runtime</artifactId>
            <version>3.31.100</version>
        </dependency>


        <!-- ================================================== -->
        <!-- ATL                                               -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.eclipse.m2m.atl</groupId>
            <artifactId>org.eclipse.m2m.atl.core</artifactId>
            <version>${atl.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.m2m.atl</groupId>
            <artifactId>org.eclipse.m2m.atl.core.emf</artifactId>
            <version>${atl.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.m2m.atl</groupId>
            <artifactId>org.eclipse.m2m.atl.engine.emfvm</artifactId>
            <version>${atl.version}</version>
        </dependency>


        <!-- ================================================== -->
        <!-- OCL Pivot                                         -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.eclipse.ocl</groupId>
            <artifactId>org.eclipse.ocl.common</artifactId>
            <version>${ocl.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.ocl</groupId>
            <artifactId>org.eclipse.ocl.pivot</artifactId>
            <version>${ocl.version}</version>
        </dependency>


        <!-- ================================================== -->
        <!-- Dependencias utilizadas por OCL / Eclipse          -->
        <!-- ================================================== -->

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>31.1-jre</version>
        </dependency>

        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
            <version>5.1.0</version>
        </dependency>

        <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
            <version>1.2.17</version>
        </dependency>


        <!-- ================================================== -->
        <!-- Metamodelos DEVS locales                           -->
        <!-- ================================================== -->

        <dependency>
            <groupId>mapper.devs.metamodel</groupId>
            <artifactId>setTheoryModel</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>mapper.devs.metamodel</groupId>
            <artifactId>mathExpressionModel</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>mapper.devs.metamodel</groupId>
            <artifactId>booleanExpressionModel</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>mapper.devs.metamodel</groupId>
            <artifactId>devsModel</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>mapper.devs.metamodel</groupId>
            <artifactId>devsComputationalModel</artifactId>
            <version>1.0.0</version>
        </dependency>


        <!-- ================================================== -->
        <!-- Tests                                             -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


    </dependencies>


    <!-- ====================================================== -->
    <!-- Repositorios                                          -->
    <!-- ====================================================== -->

    <repositories>

        <repository>
            <id>eclipse-releases</id>
            <url>https://repo.eclipse.org/content/groups/releases/</url>
        </repository>

    </repositories>


    <!-- ====================================================== -->
    <!-- Build                                                 -->
    <!-- ====================================================== -->

    <build>

        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>


</project>