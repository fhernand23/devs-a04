{
  "name": "devs-lang-web-editor",
  "version": "1.0.0",
  "private": true,
  "homepage": "/a04",
  "description": "Web editor for textual DEVS specifications backed by Mapper_DEVS",
  "scripts": {
    "start": "node --openssl-legacy-provider ./node_modules/webpack-dev-server/bin/webpack-dev-server.js --hot --open --port 3000",
    "build": "node --openssl-legacy-provider ./node_modules/webpack/bin/webpack.js --mode production",
    "antlr4ts": "antlr4ts CFG_DEVS_MODEL.g4 -o ./src/ANTLR"
  },
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "monaco-editor-core": "^0.18.1",
    "react": "^16.8.6",
    "react-dom": "^16.8.6"
  },
  "devDependencies": {
    "@types/node": "15.6.1",
    "@types/react": "^16.8.12",
    "@types/react-dom": "^16.8.3",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "css-loader": "^3.3.0",
    "html-webpack-plugin": "^3.2.0",
    "style-loader": "^1.0.1",
    "ts-loader": "^5.3.3",
    "typescript": "^5.3.2",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3"
  }
}
